---
import Base from '../layouts/Base.astro';

// Contact form. POSTs to a Cloudflare Worker (contact-relay) that pings my
// Telegram. The worker URL is wired in at build time via PUBLIC_CONTACT_RELAY_URL
// — falls back to the production URL if the env var isn't set, so local dev
// against the worker still works without a .env tweak.
const RELAY_URL =
  import.meta.env.PUBLIC_CONTACT_RELAY_URL ||
  'https://contact-relay.jhomer191.workers.dev';
---

<Base
  title="Contact — Jack Homer"
  description="Get in touch with Jack Homer."
>
  <section class="mx-auto max-w-2xl px-6 py-20">
    <h1 class="text-4xl font-bold text-text mb-3">Contact</h1>
    <p class="text-text-muted mb-10 leading-relaxed">
      Drop me a note. Goes straight to my phone — I usually reply within a few hours.
    </p>

    <form
      id="contact-form"
      class="space-y-5 rounded-2xl border border-accent/30 bg-surface p-8"
      novalidate
    >
      <div>
        <label
          for="name"
          class="block text-sm font-medium text-text mb-1.5"
        >Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="w-full rounded-lg border border-border bg-bg px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        />
      </div>

      <div>
        <label
          for="email"
          class="block text-sm font-medium text-text mb-1.5"
        >Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="w-full rounded-lg border border-border bg-bg px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        />
      </div>

      <div>
        <label
          for="message"
          class="block text-sm font-medium text-text mb-1.5"
        >Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          maxlength="4000"
          class="w-full rounded-lg border border-border bg-bg px-4 py-2.5 text-text placeholder:text-text-dim focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-colors"
        ></textarea>
      </div>

      <!-- Honeypot — hidden from humans via off-screen positioning. Bots that
           autofill every field will trip it; legit users won't see it. -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label for="website">Website (leave blank)</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full rounded-lg border border-accent bg-accent px-6 py-3 text-sm font-semibold text-bg transition-colors hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send message
      </button>

      <p
        id="status"
        class="text-sm text-text-muted hidden"
        role="status"
        aria-live="polite"
      ></p>
    </form>

    <p class="mt-6 text-xs text-text-dim">
      Or email directly:
      <a
        href="mailto:jack@homerfamily.com"
        class="text-accent hover:underline"
      >jack@homerfamily.com</a>
    </p>
  </section>
</Base>

<script is:inline define:vars={{ RELAY_URL }}>
  const form = document.getElementById('contact-form');
  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('status');

  // Optional ?subject=... param prefills the message header. Used by the
  // storefront-preview CTA on /business so the inquiry carries which mock
  // template the visitor was looking at.
  const params = new URLSearchParams(window.location.search);
  const subject = params.get('subject');
  if (subject) {
    const msg = document.getElementById('message');
    msg.value = `Re: ${subject}\n\n`;
    msg.setSelectionRange(msg.value.length, msg.value.length);
  }

  function setStatus(text, kind) {
    status.textContent = text;
    status.classList.remove('hidden', 'text-text-muted', 'text-red-400', 'text-green-400');
    status.classList.add(
      kind === 'error' ? 'text-red-400' : kind === 'success' ? 'text-green-400' : 'text-text-muted',
    );
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    // Honeypot — if filled, silently succeed without sending.
    if (data.get('website')) {
      setStatus('Sent — thanks! I\'ll be in touch.', 'success');
      form.reset();
      return;
    }

    btn.disabled = true;
    setStatus('Sending…', 'info');

    try {
      const res = await fetch(RELAY_URL, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          message: data.get('message'),
        }),
      });
      if (!res.ok) {
        const body = await res.text().catch(() => '');
        throw new Error(`HTTP ${res.status}: ${body || 'unknown error'}`);
      }
      setStatus('Sent — thanks! I\'ll be in touch.', 'success');
      form.reset();
    } catch (err) {
      console.error(err);
      setStatus(
        'Hmm, that didn\'t go through. Email jack@homerfamily.com directly and I\'ll get back to you.',
        'error',
      );
    } finally {
      btn.disabled = false;
    }
  });
</script>
